{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main editor window. The preview iframe gets no capabilities at all.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-save",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
}
